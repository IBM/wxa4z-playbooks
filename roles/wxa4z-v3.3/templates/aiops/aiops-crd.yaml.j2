apiVersion: wxa4z.watsonx.ibm.com/v1
kind: AIOpsIntegration
metadata:
  name: wxa4z-aiops
  namespace: wxa4z-aiops
spec:
  license:
    accept: true
  namespace: wxa4z-aiops
  global:
    storageClass: ocs-storagecluster-cephfs
  smu:
    hostname: "{{ smu_hostname }}"
    port: {{ smu_port }}
    username: "{{ smu_username }}"
    password: "{{ smu_password }}"
    adminUsername: "{{ smu_admin_username }}"
    adminPassword: "{{ smu_admin_password }}"
  zws:
    hostname: "{{ zws_hostname }}"
    port: {{ zws_port }}
    username: "{{ zws_username }}"
    password: "{{ zws_password }}"
  zchatopsMcpServer:
    enabled: true
    resources:
      limits:
        cpu: "2"
        memory: 2Gi
      requests:
        cpu: 200m
        memory: 1Gi
    env:
      AIOPS_USERNAME: "{{ aiops_username }}"
      AIOPS_PASSWORD: "{{ aiops_password }}"
  clusterDomain: "{{ cluster_domain }}"